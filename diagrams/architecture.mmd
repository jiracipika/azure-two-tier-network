      W1[vm-web-1 nginx]
    end
    subgraph App["snet-app 10.10.2.0/24 - NSG app"]
      API[vm-app-0 nginx :8080]
    end
    subgraph BastionSub["AzureBastionSubnet 10.10.250.0/26 - NSG bastion"]
      BAST[Bastion host :443]
    end
    NAT[NAT gateway - egress only]
