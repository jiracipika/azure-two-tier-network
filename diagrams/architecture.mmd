flowchart LR
  subgraph Internet["Trust boundary: Public Internet"]
    U[Users]
    A[Attacker / untrusted]
  end

  subgraph VNet["vnet-two-tier 10.10.0.0/16"]
    subgraph Web["snet-web 10.10.1.0/24 - NSG web"]
      LB[Public Load Balancer :80]
