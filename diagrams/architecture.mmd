  U -- "TCP 80 (allowed)" --> LB
  LB -- "probe + forward :80" --> W0
  LB -- "probe + forward :80" --> W1
  W0 -- "TCP 8080 (only from snet-web)" --> API
  W1 -- "TCP 8080" --> API
  U -- "TCP 443 (TLS session)" --> BAST
  BAST -. "SSH 22 to workloads only" .-> W0
  BAST -. "SSH 22" .-> API
  A -- "any port 22/3389/8080 - DENIED" --x App
  A -- "port 22/3389 - DENIED" --x Web
  Web -- "default_outbound disabled; NAT only" --> NAT
  App -- "default_outbound disabled; NAT only" --> NAT
  NAT -- "SNAT" --> Internet

  GH[GitHub Actions offline checks] -. "validate only, no deploy" .- VNet
